{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/blog/autocritic",
        "destination": "/lab/autocritic/",
        "type": 301
      },
      {
        "source": "/blog/autocritic/",
        "destination": "/lab/autocritic/",
        "type": 301
      },
      {
        "source": "/blog",
        "destination": "/lab/",
        "type": 301
      },
      {
        "source": "/blog/",
        "destination": "/lab/",
        "type": 301
      }
    ]
  }
}
